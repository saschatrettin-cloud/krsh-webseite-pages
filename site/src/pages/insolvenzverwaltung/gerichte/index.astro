  "Amtsgericht Neukölln: RA Schweigart",
  "Amtsgericht Pankow/Weißensee: RAe Nullmeier, Schweigart, Semmelmann",
  "Amtsgericht Schöneberg: RAe Nullmeier, Schweigart, Semmelmann",
  "Amtsgericht Spandau: RAe Nullmeier, Schweigart, Semmelmann",
  "Amtsgericht Tempelhof-Kreuzberg: RAe Nullmeier, Schweigart, Semmelmann",
  "Amtsgericht Wedding: RAe Nullmeier, Schweigart",
];
const weitereGerichte = [
  "Amtsgericht Braunschweig: RA Dr. Heitsch",
  "Amtsgericht Cottbus: RAe Dr. Heitsch, Semmelmann",
  "Amtsgericht Dessau: RA Dr. Heitsch",
  "Amtsgericht Eschwege: RA Dr. Heitsch",
  "Amtsgericht Gifhorn: RA Dr. Heitsch",
  "Amtsgericht Göttingen: RA Dr. Heitsch",
  "Amtsgericht Goslar: RA Dr. Heitsch",
  "Amtsgericht Halle: RA Rosenmüller, RAin Mocci",
  "Amtsgericht Hameln: RA Dr. Heitsch",
  "Amtsgericht Hannover: RA Dr. Heitsch, RA Semmelmann",
  "Amtsgericht Hildesheim: RA Dr. Heitsch",
  "Amtsgericht Kassel: RA Dr. Heitsch, RAin Mocci",
  "Amtsgericht Leipzig: RA Dr. Heitsch",
  "Amtsgericht Magdeburg: RA Dr. Heitsch",
  "Amtsgericht Neubrandenburg: RA Semmelmann",
