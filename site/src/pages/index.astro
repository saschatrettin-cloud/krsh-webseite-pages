---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";
import { activeInsolvencyProceedings } from "../data/insolvencyProceedings";
import { activeJobs } from "../data/jobs";
import { legalServiceSchema } from "../lib/schema";

// Startseite trägt das Sammel-LegalService-Schema. Organisation kommt
// ohnehin aus BaseLayout — hier ergänzen wir die Rechtsgebiete als
// strukturierte Liste, damit Google die Themenbreite versteht.
const siteOrigin = (Astro.site ?? new URL(SITE.url)).origin;
const structuredData = SITE.practiceAreas.slice(0, 4).map((area) =>
  legalServiceSchema(siteOrigin, area)
);

const serviceCards = [
  {
    title: "Insolvenzverwaltung",
    href: "/insolvenzverwaltung/insolvenzverwalter/",
    text: "Gerichtlich bestellte Insolvenzverwalter und Sachwalter mit langjähriger Erfahrung in Unternehmensinsolvenzen.",
  },
  {
    title: "Sanierung",
    href: "/sanierung/",
    text: "Begleitung von Unternehmen in wirtschaftlichen Krisen mit Blick auf Fortführung, Stabilisierung und rechtliche Umsetzung.",
  },
  {
    title: "StaRUG",
    href: "/starug/",
    text: "Restrukturierung außerhalb eines Insolvenzverfahrens, soweit die gesetzlichen Voraussetzungen vorliegen.",
  },
  {
    title: "Schutzschirm / Eigenverwaltung",
    href: "/schutzschirm-eigenverwaltung/",
    text: "Verfahrensgestaltung mit dem Ziel, Sanierungsspielräume strukturiert und rechtssicher zu nutzen.",
  },
];

const audienceCards = [
  {
    eyebrow: "Unternehmen",
    title: "Krise ordnen",
    href: "/sanierung/",
    text: "Erste Orientierung zu Sanierung, Restrukturierung und insolvenznahen Handlungsspielräumen.",
  },
  {
    eyebrow: "Gläubiger",
    title: "Verfahren finden",
    href: "/insolvenzverwaltung/insolvenzverfahren/",
    text: "Aktuelle Verfahren, Bekanntmachungen und weiterführende Informationen gebündelt aufrufen.",
  },
  {
    eyebrow: "Verfahrensbeteiligte",
    title: "GIS",
    href: "https://www.glaeubigerinformation.de/t/191/proceeding-search",
    text: "Direkter Zugang zu verfahrensbezogenen Informationen im GIS.",
    external: true,
  },
  {
    eyebrow: "Notariat",
    title: "Notariat",
    href: "/anwaelte-notare/notare/",
    text: "Notarielle Leistungen, Formulare und Ansprechpartner der Kanzlei.",
  },
  {
    eyebrow: "Bewerber",
    title: "Karriere",
    href: "/karriere/",
    text: "Aktuelle Stellenangebote und Einstiegsmöglichkeiten bei KRSH.",
  },
];

const trustItems = [
  { value: "seit 1975", label: "in Berlin tätig" },
  { value: "4", label: "Standorte" },
  { value: "rund 45", label: "Mitarbeiter" },
  { value: "über 1000", label: "Unternehmensinsolvenzen" },
];

const latestProceedings = activeInsolvencyProceedings.slice(0, 3);
const highlightedJobs = activeJobs.slice(0, 3);

const dateFormatter = new Intl.DateTimeFormat("de-DE", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout
  fullTitle="KRSH — Insolvenzverwaltung und Wirtschaftsrecht in Berlin"
  description="Kühnel, Rosenmüller & Kollegen — seit 1975 Berliner Kanzlei für Insolvenzverwaltung, Sanierung und Wirtschaftsrecht. Standorte in Berlin, Hannover, Kassel und Halle."
  ogImage="/assets/krsh/krsh.jpg"
  structuredData={structuredData}
  pageClass="home-page"
>
  <main class="home">
    <section class="home-hero" aria-labelledby="home-hero-title">
      <div class="home-hero__content">
        <p class="eyebrow">Kühnel, Rosenmüller &amp; Kollegen</p>
        <h1 id="home-hero-title">
          Insolvenzverwaltung, Sanierung und Wirtschaftsrecht
        </h1>
        <p>
          Seit 1975 zählt KRSH im Insolvenzrecht zu den vor allem in Berlin
          führenden Kanzleien. Die Sozietät ist beratend und verwaltend
          insbesondere bei mittelständischen Unternehmen und in der
          Immobilienwirtschaft tätig.
        </p>
        <div class="home-hero__actions">
          <a class="button button--primary" href="/insolvenzverwaltung/insolvenzverfahren/">
            Insolvenzverfahren
          </a>
          <a class="button button--secondary" href="/kontakt/">
            Kontakt aufnehmen
          </a>
        </div>
      </div>
    </section>

    <section class="quick-access" aria-labelledby="quick-access-title">
      <div class="section-heading">
        <p class="eyebrow">Schnellzugang</p>
        <h2 id="quick-access-title">Direkte Einstiege nach Anliegen</h2>
        <p>
          Der erste Zugriff folgt den wichtigsten Nutzungssituationen:
          Unternehmenskrise, Insolvenzverfahren, GIS, Notariat und Karriere.
        </p>
      </div>
      <div class="quick-access__grid">
        {audienceCards.map((item) => (
          <a
            class="quick-card"
            href={item.href}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener" : undefined}
          >
            <small>{item.eyebrow}</small>
            <span>{item.title}</span>
            <p>{item.text}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="home-section" aria-labelledby="services-title">
      <div class="section-heading section-heading--wide">
        <p class="eyebrow">Kompetenzen</p>
        <h2 id="services-title">Krisen rechtlich ordnen, Werte erhalten, Verfahren strukturieren</h2>
        <p>
          Der Schwerpunkt liegt auf Insolvenzverwaltung, Sanierung,
          Eigenverwaltung, Schutzschirmverfahren, StaRUG und wirtschaftsrechtlicher
          Beratung.
        </p>
      </div>
      <div class="service-grid">
        {serviceCards.map((item) => (
          <a class="service-card" href={item.href}>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <span>Mehr erfahren</span>
          </a>
        ))}
      </div>
    </section>

    <section class="trust-band" aria-labelledby="trust-title">
      <div class="trust-band__intro">
        <p class="eyebrow">Erfahrung</p>
        <h2 id="trust-title">Langjährige Praxis in gerichtlichen Verfahren und wirtschaftlicher Beratung</h2>
        <p>
          KRSH verbindet regionale Verankerung mit überregionaler Bestellungspraxis
          und zertifizierten Abläufen in der Insolvenzverwaltung.
        </p>
      </div>
      <dl class="trust-list">
        {trustItems.map((item) => (
          <div>
            <dt>{item.value}</dt>
            <dd>{item.label}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="home-section home-section--split home-section--proceedings" aria-labelledby="proceedings-title">
      <div class="proceedings-cockpit">
        <div class="section-heading">
          <p class="eyebrow">Insolvenzverfahren</p>
          <h2 id="proceedings-title">Verfahrens-Cockpit</h2>
          <p>
            Zentrale Einstiege für Verfahrensbeteiligte: aktuelle Verfahren,
            GIS-Zugang und Formulare.
          </p>
        </div>
        <div class="procedure-tools" aria-label="Verfahrenszugänge">
          <a href="/insolvenzverwaltung/insolvenzverfahren/">
            <span>Aktuelle Verfahren</span>
            <small>öffentliche Mitteilungen</small>
          </a>
          <a
            href="https://www.glaeubigerinformation.de/t/191/proceeding-search"
            target="_blank"
            rel="noopener"
          >
            <span>GIS öffnen</span>
            <small>externer Zugang</small>
          </a>
          <a href="/insolvenzverwaltung/informationen/">
            <span>Formulare</span>
            <small>Merkblätter und Hinweise</small>
          </a>
        </div>
        <div class="news-stack">
          {latestProceedings.map((item) => (
            <a
              class="news-card"
              href={`/insolvenzverwaltung/insolvenzverfahren/${item.slug}/`}
              aria-label={`Insolvenzverfahren öffnen: ${item.title}`}
            >
              <time datetime={item.date}>
                {dateFormatter.format(new Date(`${item.date}T00:00:00`))}
              </time>
              <h3>{item.title}</h3>
              <p>{item.teaser}</p>
              <span class="card-action">Weiterlesen</span>
            </a>
          ))}
        </div>
        <p class="section-link">
          <a href="/insolvenzverwaltung/insolvenzverfahren/">Alle Verfahren anzeigen</a>
        </p>
      </div>

      <aside class="career-panel" aria-labelledby="career-title">
        <p class="eyebrow">Karriere</p>
        <h2 id="career-title">Verstärkung für die Kanzlei</h2>
        <p>
          Als eingeführte Anwaltskanzlei sucht KRSH regelmäßig personelle
          Verstärkung. Derzeit sind {activeJobs.length} Stellenangebote aktiv.
        </p>
        <ul class="career-panel__jobs" aria-label="Aktuelle Stellenangebote">
          {highlightedJobs.map((job) => (
            <li><a href={`/karriere/${job.slug}/`}>{job.title}</a></li>
          ))}
        </ul>
        <a class="button button--secondary" href="/karriere/">Zu den Stellenangeboten</a>
      </aside>
    </section>

    <section class="home-section home-section--about" aria-labelledby="about-title">
      <div class="about-copy">
        <p class="eyebrow">Profil</p>
        <h2 id="about-title">Überregional tätig, regional verankert</h2>
        <p>
          Auch für die Insolvenzgerichte Cottbus, Eschwege, Hameln, Hannover,
          Hildesheim, Kassel, Magdeburg, Neubrandenburg, Neuruppin, Potsdam,
          Stendal und Wolfsburg ist KRSH als Verwalter tätig. Darüber hinaus
          sind Verwalter der Kanzlei auf Vorauswahllisten weiterer
          Insolvenzgerichte geführt.
        </p>
        <p>
          In mehr als 40 Jahren haben die Verwalter der Kanzlei über 1000
          Unternehmensinsolvenzen betreut. Die Insolvenzverwaltung der Sozietät
          ist durch die VQZ Bonn zertifiziert nach DIN EN ISO 9001.
        </p>
      </div>
      <div class="credential-strip" aria-label="Zertifizierungen">
        <img src="/assets/krsh/csm_VQZBonn_e09f684e07.jpg" width="130" height="130" alt="VQZ Bonn" loading="lazy" />
        <img src="/assets/krsh/csm_VQZ_Bonn_GOI_86b6275fee.jpg" width="130" height="130" alt="GOI Zertifizierung" loading="lazy" />
        <img src="/assets/krsh/csm_CERT_Logo_844714be4c.jpg" width="130" height="133" alt="VID CERT" loading="lazy" />
      </div>
    </section>
  </main>
</BaseLayout>
