---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";
import { activeInsolvencyProceedings } from "../data/insolvencyProceedings";
import { activeJobs } from "../data/jobs";
import { legalServiceSchema } from "../lib/schema";

const siteOrigin = (Astro.site ?? new URL(SITE.url)).origin;
const structuredData = SITE.practiceAreas.slice(0, 4).map((area) =>
  legalServiceSchema(siteOrigin, area)
);

const navigationSections = [
  {
    title: "Verfahren",
    items: [
      { label: "Aktuelle Verfahren", href: "/insolvenzverwaltung/insolvenzverfahren/" },
      {
        label: "GIS Gläubigerinformation",
        href: "https://www.glaeubigerinformation.de/t/191/proceeding-search",
        external: true,
      },
      { label: "Informationen und Formulare", href: "/insolvenzverwaltung/informationen/" },
      { label: "Gerichte", href: "/insolvenzverwaltung/gerichte/" },
    ],
  },
  {
    title: "Kompetenzen",
    items: [
      { label: "Insolvenzverwaltung", href: "/insolvenzverwaltung/insolvenzverwalter/" },
      { label: "Sanierung", href: "/sanierung/" },
      { label: "StaRUG", href: "/starug/" },
      { label: "Schutzschirm / Eigenverwaltung", href: "/schutzschirm-eigenverwaltung/" },
    ],
  },
  {
    title: "Kanzlei",
    items: [
      { label: "Team", href: "/anwaelte-notare/anwaelte/" },
      { label: "Notariat", href: "/anwaelte-notare/notare/" },
      { label: "Karriere", href: "/karriere/" },
      { label: "Kontakt", href: "/kontakt/" },
    ],
  },
];

const heroWords = ["Verwaltung,", "die", "Orientierung", "schafft."];

const trustItems = [
  { value: "seit 1975", label: "in Berlin tätig" },
  { value: "1000+", label: "Unternehmensinsolvenzen" },
  { value: "ISO 9001", label: "zertifizierte Insolvenzverwaltung" },
  { value: String(activeJobs.length), label: "aktive Stellenangebote" },
];

const latestProceedings = activeInsolvencyProceedings.slice(0, 3);

const dateFormatter = new Intl.DateTimeFormat("de-DE", {
  day: "2-digit",
  month: "2-digit",
  year: "numeric",
});
---

<BaseLayout
  fullTitle="KRSH — Insolvenzverwaltung und Wirtschaftsrecht in Berlin"
  description="Kühnel, Rosenmüller & Kollegen — seit 1975 Berliner Kanzlei für Insolvenzverwaltung, Sanierung und Wirtschaftsrecht. Standorte in Berlin, Hannover, Kassel und Halle."
  ogImage="/assets/hero/standortsicherung-hero.png"
  structuredData={structuredData}
  pageClass="home-page home-page--clarity"
  showSiteHeader={false}
>
  <main class="clarity-page">
    <section class="clarity-masthead" aria-label="Startseitenkopf">
      <div class="clarity-masthead__inner">
        <a href="/" class="clarity-brand" aria-label="KRSH Startseite">
          <img
            src="/assets/brand/krsh-logo-blue-on-white.png"
            width="2011"
            height="642"
            alt="Kühnel Rosenmüller &amp; Kollegen, Rechtsanwälte &amp; Notare"
          />
        </a>

        <details class="clarity-menu">
          <summary aria-label="Menü öffnen">
            <span></span>
            <span></span>
            <span></span>
          </summary>

          <nav class="clarity-menu__panel" aria-label="Hauptnavigation">
            {navigationSections.map((section) => (
              <section>
                <h2>{section.title}</h2>
                <ul>
                  {section.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        target={item.external ? "_blank" : undefined}
                        rel={item.external ? "noopener" : undefined}
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </nav>
        </details>
      </div>
    </section>

    <section class="clarity-hero" aria-labelledby="clarity-title">
      <div class="clarity-hero__layout">
        <div class="clarity-hero__main">
          <p class="clarity-kicker">Insolvenzverwaltung und Sanierung</p>

          <h1 id="clarity-title" class="clarity-title">
            {heroWords.map((word, index) => (
              <span style={`--word-index: ${index}`}>{word}</span>
            ))}
          </h1>

          <p class="clarity-mantra">Klarheit. Verbindung. Vertrauen.</p>

          <p class="clarity-copy">
            Seit 1975 begleitet KRSH Unternehmen, Gerichte und Beteiligte durch
            komplexe Verfahren. Der erste Zugriff bleibt bewusst ruhig; die
            nächste Handlung ist direkt erreichbar.
          </p>

          <div class="clarity-actions">
            <a class="clarity-button clarity-button--primary" href="/insolvenzverwaltung/insolvenzverfahren/">
              Verfahren suchen
            </a>
            <a
              class="clarity-button"
              href="https://www.glaeubigerinformation.de/t/191/proceeding-search"
              target="_blank"
              rel="noopener"
            >
              GIS öffnen
            </a>
          </div>
        </div>

        <figure
          class="clarity-visual"
          aria-label="Standortsicherung durch strukturierte Insolvenzverwaltung"
        >
          <img
            src="/assets/hero/standortsicherung-hero.webp"
            width="1408"
            height="768"
            alt="Schreibtisch mit Verfahrensordnern und Blick in einen laufenden Produktionsbetrieb"
            loading="eager"
            decoding="async"
          />
          <figcaption>Ermitteln. Fortführen. Verfahren ordnen.</figcaption>
        </figure>
      </div>

      <div class="clarity-scrollcue" aria-hidden="true">
        <span></span>
        <small>Scroll</small>
      </div>
    </section>

    <section class="clarity-depth" aria-labelledby="clarity-depth-title">
      <div class="clarity-section-heading">
        <p class="clarity-kicker">Nach dem Einstieg</p>
        <h2 id="clarity-depth-title">
          Alles Weitere folgt geordnet: Verfahren, Rollen, Kanzlei.
        </h2>
      </div>

      <div class="clarity-menu-grid" aria-label="Menüstruktur">
        {navigationSections.map((section) => (
          <section>
            <h3>{section.title}</h3>
            <ul>
              {section.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target={item.external ? "_blank" : undefined}
                    rel={item.external ? "noopener" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>

    <section class="clarity-proceedings" aria-labelledby="clarity-proceedings-title">
      <div>
        <p class="clarity-kicker">Aktuelle Verfahren</p>
        <h2 id="clarity-proceedings-title">Für Beteiligte schnell auffindbar.</h2>
      </div>

      <div class="clarity-proceedings__list">
        {latestProceedings.map((item) => (
          <a href={`/insolvenzverwaltung/insolvenzverfahren/${item.slug}/`}>
            <time datetime={item.date}>
              {dateFormatter.format(new Date(`${item.date}T00:00:00`))}
            </time>
            <span>{item.title}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="clarity-trust" aria-label="Vertrauenssignale">
      {trustItems.map((item) => (
        <div>
          <strong>{item.value}</strong>
          <span>{item.label}</span>
        </div>
      ))}
    </section>
  </main>
</BaseLayout>
