---
interface Props {
  activeService?: "kontakt" | "sitemap" | "datenschutz" | "impressum";
  activeInsolvency?: "insolvenzverwalter" | "insolvenzverfahren" | "gerichte" | "informationen" | "resultate" | "kosten";
  activeLawyers?: "anwaelte" | "notare" | "formulare";
  showServiceMenu?: boolean;
  showInsolvencyMenu?: boolean;
  showLawyersMenu?: boolean;
  imageSrc?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const {
  activeService,
  activeInsolvency,
  activeLawyers,
  showServiceMenu = false,
  showInsolvencyMenu = false,
  showLawyersMenu = false,
  imageSrc = "/assets/krsh/krsh_haus_front.jpg",
  imageAlt = "Kanzleihaus Kühnel Rosenmüller & Kollegen",
  imageWidth = 215,
  imageHeight = 291,
} = Astro.props;

const serviceItems = [
  { key: "kontakt", href: "/kontakt/", label: "Kontakt" },
  { key: "sitemap", href: "/service/sitemap/", label: "Sitemap" },
  { key: "datenschutz", href: "/service/datenschutz/", label: "Datenschutz" },
  { key: "impressum", href: "/service/impressum/", label: "Impressum" },
];

const insolvencyItems = [
  { key: "insolvenzverwalter", href: "/insolvenzverwaltung/insolvenzverwalter/", label: "Insolvenzverwalter" },
  { key: "insolvenzverfahren", href: "/insolvenzverwaltung/insolvenzverfahren/", label: "Insolvenzverfahren" },
  { key: "gerichte", href: "/insolvenzverwaltung/gerichte/", label: "Gerichte" },
  { key: "informationen", href: "/insolvenzverwaltung/informationen/", label: "Informationen" },
  { key: "resultate", href: "/insolvenzverwaltung/resultate/", label: "Resultate" },
  { key: "kosten", href: "/insolvenzverwaltung/kosten/", label: "Kosten" },
  { key: "gis", href: "https://www.glaeubigerinformation.de/t/191/proceeding-search", label: "GIS" },
];

const lawyerItems = [
  { key: "anwaelte", href: "/anwaelte-notare/anwaelte/", label: "Anwälte" },
  { key: "notare", href: "/anwaelte-notare/notare/", label: "Notare" },
  { key: "formulare", href: "/anwaelte-notare/formulare/", label: "Formulare" },
];
---

<aside id="col3" class="right-column">
  {showLawyersMenu && (
    <nav class="submenu sub" aria-label="Anwälte / Notare">
      <ul>
        {lawyerItems.map((item) => (
          <li class={activeLawyers === item.key ? "active" : undefined}>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  {showInsolvencyMenu && (
    <nav class="submenu sub" aria-label="Insolvenzverwaltung">
      <ul>
        {insolvencyItems.map((item) => (
          <li class={activeInsolvency === item.key ? "active" : undefined}>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  {showServiceMenu && (
    <nav class="submenu sub" aria-label="Servicenavigation">
      <ul>
        {serviceItems.map((item) => (
          <li class={activeService === item.key ? "active" : undefined}>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <div id="img_right">
    <img
      src={imageSrc}
      width={imageWidth}
      height={imageHeight}
      alt={imageAlt}
    />
  </div>

  <div id="adress" class="contact-panel">
    <address>
      <div id="c25" class="frame frame-default frame-type-textmedia frame-layout-0">
        <header>
          <h3>KÜHNEL, ROSENMÜLLER &amp; KOLLEGEN</h3>
        </header>
        <div class="ce-textpic ce-right ce-intext">
          <div class="ce-bodytext">
            <p>Telefax: +49 30 89 66 88 100<br />Email: <a href="mailto:krsh@krsh.de" title="Opens window for sending email" class="mail">krsh<span>@</span>krsh.de</a></p>
            <p>&nbsp;</p>
            <p>BERLIN<br />Berliner Straße 117<br />10713 Berlin-Wilmersdorf<br />Telefon: +49 30 89 66 88 0</p>
            <p>&nbsp;</p>
            <p>HANNOVER (Niederlassung)<br />Berliner Allee 13, 30175 Hannover<br />Telefon: +49 511 87 45 81 34</p>
            <p>&nbsp;</p>
            <p>KASSEL (Niederlassung)<br />Kölnische Straße 69, 34117 Kassel<br />Telefon: +49 561 71 411</p>
            <p>&nbsp;</p>
            <p>HALLE (Niederlassung)<br />Kurallee 3, 06114 Halle (Saale)<br />Telefon: +49 345 21 38 85 29</p>
          </div>
        </div>
      </div>
    </address>
  </div>
</aside>
